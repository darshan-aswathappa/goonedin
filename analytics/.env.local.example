# Supabase — SUPABASE_SERVICE_KEY has NO NEXT_PUBLIC_ prefix (server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Required for ISR fetch calls during build (set to your analytics URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: protect analytics endpoint with a secret header
# ANALYTICS_SECRET=your-secret-here
