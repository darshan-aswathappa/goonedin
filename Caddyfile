goonedin.xyz, www.goonedin.xyz {
      encode zstd gzip
      reverse_proxy frontend:3000
}

api.goonedin.xyz {
      encode zstd gzip
      reverse_proxy backend:8000
}

analytics.goonedin.xyz {
      encode zstd gzip
      reverse_proxy analytics:3001
}

# DassTracker — a separate app that predates this stack, running as the
# dasstracker.service systemd unit (node on 127.0.0.1:3000).
#
# Host nginx stays in front of it on :8080 because it holds the HTTP basic
# auth in an $apr1 (Apache MD5) .htpasswd, a format Caddy's basic_auth
# cannot read (bcrypt only). Leaving nginx to do the auth keeps that
# credential working untouched; Caddy only terminates TLS.
tracker.goonedin.xyz {
      encode zstd gzip
      reverse_proxy host.docker.internal:8080
}